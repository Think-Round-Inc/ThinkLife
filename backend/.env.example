# Copy to backend/.env and fill in. See LOCAL_SETUP_GUIDE.md ("Switching LLM Providers").

# openai | anthropic | gemini | openrouter
LLM_PROVIDER_TYPE=openai
# Optional; unset = provider default. Must be listed in brain/providers/provider_registry.py
# LLM_PROVIDER_MODEL=gpt-4o-mini

# Only the key for your LLM_PROVIDER_TYPE is required.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Example OpenRouter setup:
# LLM_PROVIDER_TYPE=openrouter
# LLM_PROVIDER_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_API_KEY=sk-or-...

# Knowledge-base embeddings: auto | local | openai | openrouter | gemini
# auto = openai if OPENAI_API_KEY is set, else a free local model (downloaded once).
# Rebuild the index (agents/zoe/utils/knowledge_index_builder.py) after changing these.
EMBEDDING_PROVIDER=auto
# EMBEDDING_MODEL=

# TTS and evaluators remain OpenAI-only (TTS is skipped without OPENAI_API_KEY).

# Vector Database Configuration (OPTIONAL)
# CHROMA_DB_DIR=chroma_db

# Server Configuration
PORT=8000
DEBUG=True

# CORS Settings
CORS_ORIGINS=http://localhost:3000

# Langfuse Configuration
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"