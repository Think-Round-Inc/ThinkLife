# OpenAI Configuration (REQUIRED)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Brain workflow (US 1.1) -- see docs/workflows/README.md
# Fallback models, tried once each when the main provider keeps failing.
# Format: provider:model, comma separated. <AGENT>_FALLBACK_PROVIDERS overrides per agent.
# WORKFLOW_FALLBACK_PROVIDERS=gemini:gemini-1.5-flash
# ZOE_FALLBACK_PROVIDERS=gemini:gemini-1.5-flash
# Turn off the LLM judge (halves LLM calls per message)
# WORKFLOW_LLM_VALIDATION=false
# Checkpoints for resuming interrupted runs: sqlite (default), memory, none
# WORKFLOW_CHECKPOINTER=sqlite
# WORKFLOW_CHECKPOINT_PATH=data/workflow_checkpoints.sqlite3
# WORKFLOW_KEEP_COMPLETED_CHECKPOINTS=false

# Vector Database Configuration (OPTIONAL)
# CHROMA_DB_DIR=chroma_db

# Server Configuration
PORT=8000
DEBUG=True

# CORS Settings
CORS_ORIGINS=http://localhost:3000

# Langfuse Observability (OPTIONAL) -- see docs/LANGFUSE_SETUP.md
# Tracing stays off unless LANGFUSE_TRACING_ENABLED=true AND both keys are set.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com   # or http://localhost:3000 if self-hosted
# LANGFUSE_RELEASE=zoe-v0.7.0                 # groups traces/evals by release
# LANGFUSE_SAMPLE_RATE=1.0                    # lower in production if needed

# Offline Evaluation Judge (OPTIONAL) -- see docs/EVAL_METRICS.md
# Overridable per run with `runner.py --judge ... --judge-model ...`
EVAL_JUDGE_PROVIDER=openai                    # openai | gemini | ollama
# EVAL_JUDGE_MODEL=                           # defaults: gpt-4o-mini | gemini-1.5-flash | llama3.1:8b
# GEMINI_API_KEY=...                          # free tier: https://aistudio.google.com/apikey
# OLLAMA_HOST=http://localhost:11434

